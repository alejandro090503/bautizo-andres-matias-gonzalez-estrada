{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/album",
      "destination": "https://panel-invitados.vercel.app/subir/bautizo-andres-matias",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/bautizo-andres-matias.ics",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/calendar; charset=utf-8"
        },
        {
          "key": "Content-Disposition",
          "value": "inline; filename=\"bautizo-andres-matias.ics\""
        }
      ]
    }
  ]
}